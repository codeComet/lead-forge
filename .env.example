# ── secrets: run `node scripts/gen-secrets.mjs --print` and paste its 6 lines here ──
POSTGRES_PASSWORD=xxx
JWT_SECRET=xxxx
ANON_KEY=xx.xxx.xxx
SERVICE_ROLE_KEY=xx.xx.xxx
SECRET_KEY_BASE=xx
DASHBOARD_PASSWORD=xxx


# ── domains ──
SITE_URL=https://leadforge.devbishal.tech
SUPABASE_PUBLIC_URL=https://lfsupabase.devbishal.tech
ADDITIONAL_REDIRECT_URLS=https://leadforge.devbishal.tech/**



POSTGRES_DB=xxxx
JWT_EXPIRY=3600
ENABLE_EMAIL_AUTOCONFIRM=true
DISABLE_SIGNUP=false
DASHBOARD_USERNAME=xxxx


# ── AI providers for website generation (set at least one key; the dashboard
#    dropdown shows only providers whose key is present). Overrides are optional. ──
ANTHROPIC_API_KEY=sk-ant-xxx-xxx-xxx
GEMINI_API_KEY=xxxx
DEEPSEEK_API_KEY=xxxx
# optional overrides (leave unset → code defaults):
# GEMINI_MODEL=gemini-2.5-pro          # or gemini-2.5-flash (bigger free quota)
# GEMINI_MAX_TOKENS=48000
# GEMINI_THINKING_BUDGET=8192
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MAX_TOKENS=8192

# ── reused straight from your old .env ──
GOOGLE_MAPS_API_KEY=xxx-xxxxx
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=xxx-xxxxx
PAGESPEED_API_KEY=xxxx


SMTP_HOST=<your mailbox provider SMTP host>
SMTP_PORT=465
SMTP_USER=hello@devbishal.com
SMTP_PASS=<mailbox password>
EMAIL_FROM=Bishal <hello@devbishal.com>


IMAP_HOST=imap.devbishal.com      # usually imap.* not smtp.* — set explicitly
IMAP_PORT=993
IMAP_USER=hello@devbishal.com
IMAP_PASS=<mailbox password>
IMAP_SENT_FOLDER=Sent