# ─── Supabase ────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server + worker only, NEVER expose to client

# ─── Google ──────────────────────────────────────────────────
# Server key (Places API New). Restrict to Places API.
GOOGLE_MAPS_API_KEY=your-google-server-key
# Browser key for the map JS SDK (public, restrict by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=your-google-browser-key
# PageSpeed Insights (can reuse maps server key if enabled)
PAGESPEED_API_KEY=your-pagespeed-key

# ─── AI (Anthropic Claude) ───────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ─── Email (Resend) ──────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM="Your Name <you@yourdomain.com>"

# ─── Queue (Upstash Redis, or any Redis URL) ─────────────────
REDIS_URL=rediss://default:password@your-host.upstash.io:6379

# ─── App ─────────────────────────────────────────────────────
# Public base URL of the web app (used for tracking pixels / unsubscribe links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
