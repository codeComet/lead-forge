# ════════════════════════════════════════════════════════════════════
#  LeadForge — Docker / Dokploy environment
#  1. cp .env.docker.example .env
#  2. node scripts/gen-secrets.mjs        # fills the SECRETS block below
#  3. set the DOMAINS + API KEYS, then: docker compose up -d --build
# ════════════════════════════════════════════════════════════════════

# ── DOMAINS ─────────────────────────────────────────────────────────
# Public URL of the Next.js app (where users log in).
SITE_URL=https://app.example.com
# Public URL of the Supabase API gateway (Kong). Use a separate (sub)domain.
SUPABASE_PUBLIC_URL=https://supabase.example.com
# Extra allowed auth redirect URLs (comma-separated). Usually SITE_URL/**.
ADDITIONAL_REDIRECT_URLS=https://app.example.com/**

# Host ports (ignored when Dokploy/Traefik routes by domain to the container).
WEB_PORT=3000
KONG_HTTP_PORT=8000
STUDIO_PORT=3010

# ── SECRETS (run: node scripts/gen-secrets.mjs to fill these) ───────
POSTGRES_DB=postgres
POSTGRES_PASSWORD=
# 40+ char random string. ANON_KEY / SERVICE_ROLE_KEY are HS256 JWTs signed with it.
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=
# 64-char random string for Realtime.
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=supabaserealtime
# Studio (optional profile) basic-auth.
DASHBOARD_USERNAME=supabase
DASHBOARD_PASSWORD=

# ── AUTH behaviour ──────────────────────────────────────────────────
# true = accounts are usable immediately (no confirmation email needed).
ENABLE_EMAIL_AUTOCONFIRM=true
DISABLE_SIGNUP=false

# ── AI + external APIs ──────────────────────────────────────────────
# Website generation supports Gemini / Claude / DeepSeek. Set at least one key;
# the dashboard dropdown shows only providers whose key is present. Pick the
# active one per-org in Settings → Website generation.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
# optional overrides (leave unset → code defaults):
# GEMINI_MODEL=gemini-2.5-pro          # or gemini-2.5-flash (bigger free quota)
# GEMINI_MAX_TOKENS=48000
# GEMINI_THINKING_BUDGET=8192
# DEEPSEEK_MODEL=deepseek-chat
# DEEPSEEK_MAX_TOKENS=8192
GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=
PAGESPEED_API_KEY=

# ── Outbound email (SMTP) ───────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_ADMIN_EMAIL=admin@example.com
SMTP_SENDER_NAME=LeadForge
EMAIL_FROM=LeadForge <no-reply@example.com>
